      "version": "0.2.0",
      "configurations": [
            {
                  "name": "Flutter",
                  "type": "dart",
                  "request": "launch",
                  "program": "lib/main.dart"
            },
            {
                  "args": [
                        "--extensionDevelopmentPath=${workspaceFolder}"
                  ],
                  "name": "Iniciar a Extensão",
                  "outFiles": [
                        "${workspaceFolder}/out/**/*.js"
                  ],
                  "preLaunchTask": "npm",
                  "request": "launch",
                  "type": "extensionHost"
            },
            {
                  "name": "api",
                  "request": "launch",
                  "type": "dart"
            },
            {
                  "name": "api (profile mode)",
                  "request": "launch",
                  "type": "dart",
                  "flutterMode": "profile"
            },
            {
                  "name": "api (release mode)",
                  "request": "launch",
                  "type": "dart",
                  "flutterMode": "release"
            }
      ]
}